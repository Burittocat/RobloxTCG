--[[
	화면 전체가 참조하는 색/치수/글자 크기 한 곳.

	여기 숫자만 바꾸면 전체 톤이 바뀐다. 카드 아트가 아직 없으므로
	"카드 종류 = 색" 이 유일한 시각적 구분이다 — 그래서 색을 상수로 묶어뒀다.

	--------------------------------------------------------------------------
	가시성 기준

	글자 크기는 개별 위젯에서 정하지 않고 아래 Theme.text 척도에서 고른다.
	그러지 않으면 "여기만 10, 저기만 11" 이 쌓여서 전체를 키울 방법이 없어진다.

	가장 작은 글자를 12 로 잡았다. 로블록스는 창 크기가 제각각이고 텔레비전으로도
	보는데, 10~11 은 그 조건에서 읽으라고 두기 어렵다.

	흐린 글자(textDim / textFaint)는 어두운 배경 위에서 대비를 재서 정했다.
	특히 textFaint 는 카드 위의 "탭됨" · "공격 불가" 처럼 **놓치면 오조작으로 이어지는**
	정보에 쓰이므로, 장식용으로 흐리게 두면 안 된다.
]]

local Theme = {}

Theme.color = {
	-- 바탕. 카드와 패널이 떠 보이도록 가장 어둡게 둔다.
	bg = Color3.fromRGB(18, 21, 31),
	bgDeep = Color3.fromRGB(10, 12, 18),

	-- 패널은 바탕보다 확실히 밝아야 경계가 보인다.
	panel = Color3.fromRGB(33, 39, 55),
	panelSoft = Color3.fromRGB(46, 54, 74),
	stroke = Color3.fromRGB(74, 85, 112),

	text = Color3.fromRGB(240, 244, 252),
	textDim = Color3.fromRGB(180, 189, 208),
	textFaint = Color3.fromRGB(146, 156, 178),

	me = Color3.fromRGB(94, 214, 155),
	foe = Color3.fromRGB(242, 112, 108),
	accent = Color3.fromRGB(247, 206, 112),
	stack = Color3.fromRGB(190, 144, 242),
	ok = Color3.fromRGB(94, 214, 155),
	warn = Color3.fromRGB(242, 112, 108),

	--[[
		전투 화살표. 공격은 빨강, 방어는 파랑 — 사용자가 정한 약속이다.
		me/foe(초록·붉은색)와 겹치지 않게 더 진하고 선명한 값을 쓴다.
		선은 보드 위에 겹쳐 그려지므로, 카드 색보다 튀어야 눈에 먼저 들어온다.
	]]
	arrowAttack = Color3.fromRGB(232, 66, 62),
	arrowBlock = Color3.fromRGB(80, 156, 248),

	-- 화살표 밑에 깔리는 어두운 선. 보드 색이 제각각이라 밝은 선만으로는
	-- 카드 위를 지날 때 묻힌다 — 이 색이 선의 윤곽을 만든다.
	arrowShade = Color3.fromRGB(8, 10, 16),

	-- 카드 종류
	cost = Color3.fromRGB(78, 132, 100),
	creature = Color3.fromRGB(72, 106, 162),
	spell = Color3.fromRGB(128, 86, 162),
}

-- 키워드 칩 색. 룰 로직은 절대 색을 보지 않는다 — 표기 전용.
-- 어두운 칩 배경 위에 얹히므로 전부 밝은 쪽으로 잡았다.
Theme.keywordColor = {
	Haste = Color3.fromRGB(246, 182, 96),
	Flying = Color3.fromRGB(126, 198, 244),
	Taunt = Color3.fromRGB(224, 140, 112),
	Ranged = Color3.fromRGB(158, 212, 138),
	Instant = Color3.fromRGB(200, 156, 244),
}

Theme.font = {
	regular = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}

--[[
	글자 크기 척도. 위젯은 여기서만 고른다.

	  tiny   키워드 칩처럼 한두 글자짜리 표식
	  small  부가 정보 (카드 설명 · 상태 · 로그)
	  body   본문 기본값
	  label  버튼 · 이름처럼 눈이 먼저 가야 하는 것
	  stat   카드의 공격력/체력
	  title  화면 제목
	  life   라이프 — 판에서 가장 자주 보는 숫자
]]
Theme.text = {
	tiny = 12,
	small = 13,
	body = 14,
	label = 16,
	stat = 22,
	title = 20,
	life = 34,
	banner = 22,
	-- 턴이 바뀔 때 화면 한가운데 잠깐 뜨는 글자. 척도에서 가장 크다 —
	-- 카드를 보고 있어도 읽히라고 띄우는 것이라 작으면 존재 이유가 없다.
	flash = 42,
}

--[[
	치수는 **일부러 안 키웠다.**

	레이아웃이 고정이라 세로 예산이 빠듯하다 — 카드를 10px 키우면 위아래로 20,
	보드 절반마다 그만큼이라 768px 창에서 가운데 영역이 음수가 된다.
	대신 아래 uiScale 이 창 크기에 맞춰 화면 전체를 늘리고 줄인다.
	그래서 큰 모니터에서는 이 숫자들보다 실제로 크게 보인다.
]]
Theme.size = {
	handCard = Vector2.new(116, 170),
	fieldCard = Vector2.new(96, 124),
	costChip = Vector2.new(34, 46),
	topBar = 46,
	handBar = 192,
	actionBar = 172,
	playerPanel = 92,
	fieldRow = 132,
}

--[[
	화면 전체 배율.

	위 치수는 세로 900px 창을 기준으로 잡혀 있다. 1440p·4K 모니터에서 그대로 두면
	글자가 손톱만 해지고, 768px 창에서는 보드가 잘린다. 뷰포트 높이에 비례해
	전체를 늘렸다 줄인다 — 카드 한 장의 정보량은 그대로 두고 "크게 보이게" 만 한다.

	상한을 1.5 로 둔 이유: 그 이상 키우면 손패가 화면 밖으로 밀린다.
	하한 0.8 은 그 아래로 줄이면 글자가 다시 안 읽히는 지점이다.
]]
Theme.uiScale = {
	referenceHeight = 900,
	min = 0.8,
	max = 1.5,
}

--[[
	하이라이트 두께. 카드가 나란히 붙어 있으면 얇은 테두리는 서로 묻힌다.
	"누를 수 있는 것" 은 한눈에 세어질 만큼 굵어야 한다.
]]
Theme.outline = {
	idle = 1,
	selected = 4,
	highlighted = 4,
}

Theme.tween = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

--[[
	연출 타이밍 한 곳.

	숫자의 출처는 **사용자가 준 카드 게임 플레이 영상**이다 (10fps GIF, 300프레임).
	프레임을 세어 잰 값이라 ±0.1초 오차가 있다. "영상과 같게" 가 사용자가 정한 방향이라
	빠르게 줄이지 않고 관측치 그대로 뒀다 — 바꿀 일이 생기면 여기 숫자만 고친다.

	재는 방법: 움직임이 시작된 프레임과 멎은 프레임 번호 차 ÷ 10.

	  turnBanner   턴이 바뀔 때 화면 한가운데 글자. 뜬 뒤 hold 만큼 머물고
	               rise 만큼 위로 밀리며 사라진다 (관측 f140~f143)
	  tap          코스트를 쓰거나 공격해서 카드가 눕는 시간
	  outline      선택·대상 테두리가 바뀌는 시간. 눈이 따라올 만큼만 짧게
	  damage       라이프가 깎일 때 숫자가 떠올랐다 사라지는 시간

	손패·필드 줄은 UIListLayout 을 떼고 Battle:placeRow 가 직접 배치한다.
	그래서 카드 위치에 트윈을 걸 수 있다 — 레이아웃이 덮어쓰지 않는다.
]]
Theme.motion = {
	turnBanner = {
		fadeIn = 0.2,
		hold = 0.4,
		fadeOut = 0.35,
		rise = 34,
	},
	tap = 0.18,
	outline = 0.12,

	--[[
		카드가 자리로 들어오고 자리를 옮기는 시간.

		  deal        새 카드가 줄 밖에서 제 자리로 들어오는 시간 (관측 f81~f86, 0.5초)
		  reflow      이미 있던 카드가 자리를 다시 잡는 시간. deal 보다 짧아야 한다 —
		              새로 온 카드에 눈이 가야지, 옆으로 밀리는 카드가 주인공이 되면 안 된다
		  summonRise  필드에 나오는 생물이 **아래에서** 올라오는 거리(px).
		              손패가 아래에 있으니 그쪽에서 올라오는 것으로 읽힌다
	]]
	deal = 0.5,
	reflow = 0.22,
	summonRise = 46,

	--[[
		손패 부채꼴. 영상에서 손패는 일자로 늘어서지 않고 **쥔 것처럼 호를 그린다**
		(관측 f75~f77). 가운데 카드가 가장 높고 바깥으로 갈수록 기울며 내려간다.

		  angle  바깥 카드가 기우는 최대 각도
		  arc    바깥 카드가 내려가는 최대 거리(px)

		작게 잡았다. 카드가 116x170 이라 각도를 키우면 회전한 모서리가 옆 카드를
		덮어서 무슨 카드인지 안 읽힌다 — 손패는 읽으라고 있는 줄이다.
	]]
	fan = { angle = 5, arc = 8 },

	--[[
		상대가 낸 카드를 크게 띄우는 시간 (관측 f40~f49).

		이건 장식이 아니라 **읽을 시간**이다. 대응 패스를 사람이 직접 누르기로 한 것과
		같은 이유다 — 상대가 뭘 냈는지 모른 채로 차례가 넘어오면 안 된다.

		  travel  옆에서 들어와 멎기까지 (f40~f42)
		  hold    멎어 있는 시간 (f42~f47)
		  exit    물러나며 사라지기까지
		  rise    물러날 때 올라가는 거리(px)
	]]
	spotlight = {
		travel = 0.2,
		hold = 0.5,
		exit = 0.25,
		rise = 26,
	},

	-- 스포트라이트가 사라질 때 퍼지는 고리 (관측 f48~f49)
	ring = { grow = 0.22, size = 300 },
	damage = {
		travel = 0.55,
		rise = 42,
	},

	--[[
		카드가 때리는 동작.

		화살표만으로는 "누가 누구를 친다" 는 **계획**까지밖에 못 보여준다.
		실제로 때리는 장면이 없으면 전투는 숫자가 조용히 바뀌는 일이 된다 —
		그래서 공격자가 대상까지 달려갔다 돌아온다.

		네 박자다. 되감고(windup) · 달려들고(dash) · 부딪힌 채 멎고(hold) ·
		제자리로(recover). 되감기가 없으면 그냥 미끄러지는 것처럼 보인다 —
		때리기 직전에 뒤로 빼는 동작이 타격감의 대부분이다.

		  reach     대상까지 거리의 몇 %까지 가는가. 1 이면 카드가 완전히 겹쳐
		            대상이 안 보인다. 닿기 직전에 멎어야 부딪힌 것으로 읽힌다
		  backswing 되감을 때 뒤로 빼는 거리(px)
		  stagger   여러 공격이 동시일 때 시차. 0 이면 전부 한꺼번에 움직여
		            무슨 일이 일어났는지 못 따라간다
	]]
	strike = {
		windup = 0.1,
		dash = 0.13,
		hold = 0.07,
		recover = 0.22,
		reach = 0.58,
		backswing = 16,
		stagger = 0.06,
	},

	--[[
		맞은 쪽이 흔들린다. 짧고 빨라야 한다 — 길면 카드가 춤춘다.
		distance 는 한 번에 밀리는 거리(px), times 는 왕복 횟수.
	]]
	shake = { distance = 8, times = 3, each = 0.045 },

	--[[
		죽는 카드. 스냅샷에서는 이미 사라진 것을 붙잡아 두고 보여주는 것이라
		(Reconcile 의 exit) 이 시간이 곧 "얼마나 붙잡아 두는가" 다.
		때리는 동작보다 길어야 맞고 죽는 순서가 보인다.
	]]
	death = { fade = 0.34, drop = 20, spin = 10 },

	--[[
		맞은 생물의 공격력/체력 수치가 바뀔 때.

		수치는 스냅샷이 오는 즉시가 아니라 **부딪히는 순간**에 바뀐다
		(Battle:revealStat). 플레이어 라이프 숫자를 미룬 것과 같은 이유다 —
		공격자가 아직 달려가는 중인데 체력이 먼저 깎이면 원인과 결과가 안 이어진다.

		바뀌는 것만으로는 눈에 안 띈다. 글자를 잠깐 키웠다 되돌려서 **어디를 봐야
		하는지**를 알려준다. grow 는 키우는 px, settle 은 되돌아오는 시간.
	]]
	statHit = { grow = 10, settle = 0.2 },
}

--[[
	전투 화살표의 모양.

	직선 막대 하나로 긋다가 바꿨다. 카드 게임의 화살표는 **곡선**이다 — 곧은 선은
	보드의 가로세로 선과 섞여서 화살표로 안 읽히고, 두 카드가 세로로 마주 보면
	길이만 있고 방향이 없는 선이 된다.

	  bow        직선 길이 대비 옆으로 부푸는 정도. 0 이면 직선
	  tail/head  시작과 끝 두께. 끝으로 갈수록 굵어지면 **어디로 가는지**가
	             화살촉을 보기 전에 읽힌다
	  segment    조각 하나의 목표 길이(px). 짧을수록 곡선이 매끄럽고 조각이 늘어난다
	  overlap    조각을 이만큼 곱해 늘여 서로 겹치게 한다. 안 겹치면 곡선 안쪽에
	             톱니 같은 틈이 생긴다
	  outline    밑에 깔리는 어두운 선이 얼마나 더 굵은가(px)
	  pulse      선을 따라 흐르는 밝기. speed 는 초당 흐르는 횟수,
	             depth 는 얼마나 밝아지는가, width 는 밝은 띠의 폭(0~1)
]]
Theme.arrow = {
	bow = 0.2,
	tail = 4,
	head = 11,
	--[[
		화살촉의 크기(글리프 TextSize). 촉이 담기는 프레임도 이 값의 두 배로
		만들어지므로 여기만 고치면 된다.

		선 두께(head)의 **서너 배**는 돼야 촉으로 읽힌다. 32 일 때는 11px 선 끝에
		살짝 넓은 부분이 붙은 정도라, 화살표가 어디를 가리키는지는 알겠는데
		'촉' 으로 보이지 않았다.
	]]
	headSize = 48,
	segment = 14,
	maxSegments = 20,
	overlap = 1.7,
	outline = 3,
	pulse = { speed = 1.6, depth = 0.45, width = 0.3 },
	transparency = 0.08,
}

return Theme
