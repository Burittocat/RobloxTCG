--[[
	매칭 관련 상수 한 곳.

	룰 상수가 아니므로 src/shared/Rules/Config.luau 에 두지 않았다. 저기는 "카드 게임의
	규칙", 여기는 "서버 운영 파라미터" 다 — 바뀌는 이유가 서로 다르면 파일도 나눈다.
]]

local Settings = {}

--==========================================================================
-- 큐
--==========================================================================

-- MemoryStore 큐 이름. 구조를 바꾸면 뒤의 숫자를 올린다 —
-- 옛 버전 서버가 남아 있을 때 서로 다른 모양의 엔트리를 읽는 사고를 막는다.
Settings.queueName = "TCG_QUICKMATCH_V1"

-- 엔트리 수명(초). 이보다 오래된 엔트리는 주인이 사라진 것으로 보고 버린다.
-- 서버가 죽으면 그 서버가 넣은 엔트리를 지워줄 사람이 없으므로 TTL 이 유일한 청소부다.
Settings.entryTtl = 90

-- 큐를 훑는 주기(초). 짧을수록 매칭이 빠르지만 MemoryStore 요청 할당량을 먹는다.
--
-- 할당량은 **게임 전체가 나눠 쓰는 하나의 통** 이다 (분당 1000 + 동시접속자당 120).
-- 서버마다 따로 주는 게 아니라서 서버 수가 늘면 같이 빠듯해진다.
-- 다행히 ReadAsync 는 "돌려준 항목 수" 만큼 먹으므로, 큐가 비어 있는 대부분의
-- 서버는 폴링해도 1 유닛씩만 쓴다. 2초(=30회/분)면 여유가 있다.
Settings.pollInterval = 2

-- 한 번에 꺼내볼 엔트리 수. 짝을 여러 쌍 한꺼번에 만들 수 있다.
Settings.readBatch = 10

-- 읽은 엔트리가 다른 서버에게 안 보이는 시간(초).
-- 짧게 잡는 이유: 짝이 없어 되돌려놓지 못한 엔트리가 이 시간만큼 큐에서 증발한다.
Settings.invisibilityTimeout = 8

--==========================================================================
-- 서버 간 통신
--==========================================================================

-- 짝을 지은 서버가 "이 사람들 태워보내라" 를 뿌리는 채널.
Settings.messagingTopic = "TCG_MATCH_FOUND"

-- 텔레포트 실패 재시도. Roblox 텔레포트는 간헐적으로 실패한다(문서 권장 = 재시도).
Settings.teleportRetries = 3
Settings.teleportRetryDelay = 1

--==========================================================================
-- 대전 서버
--==========================================================================

-- 먼저 도착한 쪽이 상대를 기다리는 최대 시간(초).
-- 넘기면 부전승이 아니라 로비로 돌려보낸다 — 안 온 사람에게 패배를 주면
-- 텔레포트 실패 한 번이 전적에 남는다.
Settings.arenaWaitTimeout = 30

-- 대전이 끝나고 결과 화면을 보여주는 시간(초). 넘기면 로비로 돌려보낸다.
Settings.arenaLingerAfterMatch = 120

return table.freeze(Settings)
