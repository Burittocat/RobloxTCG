--[[
	룰 상수 한 곳 모음.

	★ 표시가 붙은 항목은 기획서에서 명시되지 않았거나 서로 모순되는 부분이라
	   내가 임의로 결정한 값이다. 밸런싱/기획 확정 시 여기만 고치면 된다.
	   (근거는 각 항목 주석에 적어뒀다.)
]]

local Config = {}

--==========================================================================
-- 매치 기본값
--==========================================================================

Config.startingLife = 30 -- 기획서: 라이프 포인트 30
Config.startingHandSize = 7 -- 기획서: 2인전은 7장 뽑고 시작
Config.deckSize = 60 -- 기획서: 총 덱 60장 (2026-09-09 사용자 확정: 유지)

-- ★ 기획서에 없음. 같은 카드 최대 매수. MTG 관례(4장)를 따랐다.
--   코스트 카드는 24~30장을 넣으라고 했으므로 이 제한에서 제외한다.
Config.maxCopiesPerCard = 4
Config.copyLimitExemptTypes = table.freeze({ Cost = true })

-- 기획서: "총 덱 60장 중 자신이 원하는 만큼(보통 24 ~ 30장)"
-- 하드 제한이 아니라 덱 빌더에서 보여줄 권장 범위로만 쓴다.
Config.recommendedCostCardRange = table.freeze({ min = 24, max = 30 })

--==========================================================================
-- 턴 진행
--==========================================================================

Config.costCardsPerTurn = 1 -- 기획서: 1턴당 한 번 코스트 카드 소환

-- ★ 기획서에 없음. 선공 1턴 드로우 여부.
--   드로우를 주면 선공이 카드 우위 + 템포 우위를 동시에 가져 지나치게 유리하다.
--   MTG/하스스톤 모두 선공에게 페널티를 준다 → 선공 첫 턴 드로우 스킵.
Config.firstPlayerSkipsFirstDraw = true

-- ★ 기획서에 없음. 손패 상한. 0 이면 무제한.
Config.handSizeLimit = 0

--[[
	★ 기획서에 없음. 멀리건 (2026-09-09 사용자 확정: **무료 1회 전체 교체**).

	판 시작 전에 손패를 한 번, 벌칙 없이 통째로 바꿀 수 있다. 물리면 손패를 덱에
	되돌려 섞고 같은 장수를 다시 뽑는다.

	왜 이 방식인가: 코스트 카드가 60장 중 24장이라 "코스트만 7장" 이나 "코스트 0장" 이
	실제로 나온다. 그 판은 아무것도 못 하고 끝나는데, 그게 게임을 배우는 사람에게
	제일 먼저 오는 경험이면 안 된다. 벌칙(런던/파리 멀리건)은 카드 풀이 넓어지고
	덱 구성이 생긴 다음에 얹는 게 순서다.
]]
Config.mulliganEnabled = true

--[[
	★ 기획서에 없음. AI 가 손패를 물리는 기준 (손패 7장 중 코스트 카드 수).

	스타터 덱은 60장 중 24장이 코스트라 기대값이 2.8장이다. 0~1 장이면 몇 턴 동안
	아무것도 못 내고, 5장 이상이면 낼 것이 없다. 그 사이는 판이 굴러가므로 둔다.
]]
Config.aiMulliganMinCost = 1
Config.aiMulliganMaxCost = 5

-- ★ 기획서에 없음. 선공을 어떻게 정하는가.
--   PvP 빠른 대전에서는 "항상 1번 좌석이 선공" 이 곧 "먼저 큐에 들어온 사람이 선공" 이라
--   매칭 순서가 유불리가 되어버린다. 매치 시드로 동전을 던진다(장르 표준).
--   false 로 두면 1번 좌석 고정 선공.
Config.randomFirstPlayer = true

-- 기획서: "코스트 카드는 소환하자마자 언탭되지 않는다"
--   = 소환한 턴에도 탭해서 쓸 수 있고(언탭 상태로 등장), 한 번 탭하면
--     다음 자기 언탭 스텝까지 다시 언탭되지 않는다.
--   (앞 문장 "소환하고 탭하여 사용할 수 있으며"와 맞추려면 이 해석뿐이다.)
Config.costCardEntersUntapped = true

--==========================================================================
-- 소환 / 탭
--==========================================================================

-- 기획서: 수비준비 페이즈에 소환하는 일반 생물은 언탭 상태로 나올 수 없다
--   → 탭된 채 등장 → 그 턴 방어 불가. 신속 생물만 언탭으로 등장해 바로 방어.
Config.defensePhaseSummonEntersTapped = true

-- ★ 기획서에 없음. 공격 선언 시 공격 생물을 탭할지.
--   탭하지 않으면 공격 후에도 방어가 가능해 "탭" 자원 개념이 무의미해진다. → 탭한다.
Config.attackingTapsCreature = true

-- 방어는 탭을 요구하지 않지만, 이미 탭된 생물은 방어할 수 없다. (장르 표준)
Config.blockingTapsCreature = false

-- ★ 기획서에 없음. 공격자 하나를 몇 마리가 함께 막을 수 있는가.
--    1 로 두면 판정이 단순하고(누가 얼마를 맞을지 배분할 필요가 없다) 버그가 줄어든다.
--    다중 방어를 열려면 데미지 배분 순서 입력이 추가로 필요하다.
Config.maxBlockersPerAttacker = 1

-- ★ 기획서에 없음. 생물을 직접 겨냥해 공격했을 때 탭된 생물도 반격하는가.
--    true = 순수 트레이드(장르 표준). false 로 두면 "탭 시키고 잡아먹기"가 강해진다.
Config.tappedCreaturesStrikeBack = true

--==========================================================================
-- 키워드 상세
--==========================================================================

-- 기획서: "'원거리' 생물이 플레이어를 직접 공격하면 공격력의 반만 적용"
-- ★ 반올림 방향은 미지정. 내림(floor)을 채택 — 공격력 1 원거리가 0 딜이 되어
--    "직접 딜은 약하다"는 의도가 더 선명해진다.
Config.rangedDirectDamageDivisor = 2
Config.rangedDirectDamageRounding = "floor" -- "floor" | "ceil"

-- ★ 기획서는 비행 공격자를 막으려면 '원거리'가 필요하다고만 적었다.
--    문자 그대로면 비행끼리도 서로 방어 못 해 비행이 사실상 무적이 된다.
--    비행도 비행을 막을 수 있게 열어둔다. false 로 바꾸면 기획서 문자 그대로.
Config.flyingCanBlockFlying = true

-- 기획서: 지상 생물은 비행을 공격할 수 없다 / 원거리는 비행을 공격할 수 있다.
--         비행 생물끼리는 서로 공격 가능(= 지상이 아니므로 제한에 안 걸림).
Config.groundCannotAttackFlying = true

-- 기획서: 도발이 전장에 있으면 플레이어를 우선 공격할 수 없다.
--         원거리는 도발을 무시한다. 비행은 도발을 무시하지 못한다.
Config.tauntBlocksDirectAttack = true

--==========================================================================
-- 우선권(어느 페이즈에 누가 무엇을 할 수 있는가)
--==========================================================================

-- ★ 기획서는 공격준비 페이즈의 상대 행동을 언급하지 않았다.
--    여기서 즉시시전을 못 쓰면 "공격 선언에 대응한다"는 플레이가 불가능해져
--    즉시시전의 가치가 크게 떨어진다. → 허용.
Config.opponentMayCastInstantDuringAttackPrep = true

-- 공수(데미지 해결) 페이즈에는 아무도 행동할 수 없다. 기획서에 행동 항목이 없음.
Config.anyoneMayActDuringCombat = false

--==========================================================================
-- 덱 아웃
--==========================================================================

-- ★ 기획서에 없음. 빈 덱에서 드로우하면 패배(MTG 방식).
Config.deckOutCausesLoss = true

return table.freeze(Config)
